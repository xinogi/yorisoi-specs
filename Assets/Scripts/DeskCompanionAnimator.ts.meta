  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">DeskCompanionAnimator – idle / walk / talk / wave / lean_in / read / dance / pose</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject modelRoot {"hint":"The swappable visual model root (CompanionModel)"}'
    - '// @input Component.RenderMeshVisual videoCard {"hint":"Video character: the camera-facing card whose material shows the clips (additive, black = see-through)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Video clips (Assets/Companion/Clips/*.mp4)</span>"}'
    - '// @ui {"widget":"group_start", "label":"Video clips"}'
    - '// @input Asset.Texture idleVideo {"hint":"idle.mp4 — loops"}'
    - '// @input Asset.Texture walkVideo {"hint":"walk.mp4 — loops while she walks"}'
    - '// @input Asset.Texture talkVideo {"hint":"talk.mp4 — loops while she speaks"}'
    - '// @input Asset.Texture waveVideo {"hint":"wave.mp4 — once, when you call her"}'
    - '// @input Asset.Texture leanInVideo {"hint":"lean_in.mp4 — once, when she teases you"}'
    - '// @input Asset.Texture readVideo {"hint":"read.mp4 — once, when she opens the book"}'
    - '// @input Asset.Texture danceVideo {"hint":"dance.mp4 — once, for the dance button"}'
    - '// @input Asset.Texture poseVideo {"hint":"pose clip — once, for the pose button (empty = uses the dance clip)"}'
    - '// @input Asset.Texture happyLaughVideo {"hint":"happy_laugh.mp4 — once, after she sums up the book"}'
    - '// @input Asset.Texture surprisedVideo {"hint":"surprised.mp4 — once, when you call her right after she teased you"}'
    - '// @input Asset.Texture thoughtfulVideo {"hint":"thoughtful.mp4 — once, while she explains a word"}'
    - '// @input Asset.Texture poutVideo {"hint":"pout.mp4 (optional) — once, when poked too often (empty = scold, then surprised)"}'
    - '// @input Asset.Texture scoldVideo {"hint":"scold.mp4 (optional) — used when there is no pout clip"}'
    - '// @input Asset.Texture forgiveVideo {"hint":"forgive.mp4 (optional) — once, when she forgives you (empty = idle)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">AnimationPlayer clip names (3D model only)</span>"}'
    - '// @ui {"widget":"group_start", "label":"Clip names"}'
    - '// @input string idleClip = "idle" {"hint":"Substring of the idle clip"}'
    - '// @input string walkClip = "walk" {"hint":"Substring of the walk clip"}'
    - '// @input string talkClip = "talk" {"hint":"Substring of the talk clip"}'
    - '// @input string waveClip = "wave" {"hint":"Substring of the wave clip"}'
    - '// @input string leanInClip = "lean" {"hint":"Substring of the lean-in / tease clip"}'
    - '// @input string readClip = "read" {"hint":"Substring of the read clip"}'
    - '// @input string danceClip = "dance" {"hint":"Substring of the dance clip"}'
    - '// @input string poseClip = "pose" {"hint":"Substring of the pose clip"}'
    - '// @input string happyLaughClip = "laugh" {"hint":"Substring of the happy / laugh clip"}'
    - '// @input string surprisedClip = "surpris" {"hint":"Substring of the surprised clip"}'
    - '// @input string thoughtfulClip = "thought" {"hint":"Substring of the thoughtful clip"}'
    - '// @input string poutClip = "pout" {"hint":"Substring of the pout clip"}'
    - '// @input string scoldClip = "scold" {"hint":"Substring of the scold clip"}'
    - '// @input string forgiveClip = "forgive" {"hint":"Substring of the forgive clip"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float stepsPerSecond = 1.8 {"hint":"Steps per second while walking (footstep sounds use this too)", "widget":"slider", "min":0.5, "max":3, "step":0.1}'
    - '// @input float fallbackOnceSeconds = 2.5 {"hint":"Length of a play-once hook when there is no clip to time it (s)", "widget":"slider", "min":1, "max":8, "step":0.5}'
    - '// @ui {"widget":"group_end"}'
