  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">DeskCompanionController – always in front, tease, come when called, read, dance</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 animator {"hint":"Animation hooks for the model"}'
    - '// @input AssignableType_2 voice {"hint":"Voice + subtitles"}'
    - '// @input AssignableType_3 sounds {"hint":"Spatial footsteps and small sounds"}'
    - '// @input SceneObject facing {"hint":"Optional: a child that holds a 3D model and should yaw toward where she walks. Leave empty for the video card (it billboards to you on its own)."}'
    - '// @input SceneObject handAnchor {"hint":"Point in front of her chest where a handed book is held"}'
    - '// @input AssignableType_4 book {"hint":"The grabbable stand-in book on the desk"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Front zone (always in view)</span>"}'
    - '// @ui {"widget":"group_start", "label":"Front zone"}'
    - '// @input float restDistanceCm = 250 {"hint":"Resting distance in front of you (cm). Brief: ~2.5 m. Whole body fits in view when you look ~14° down, or from ~4.5 m when looking level while standing.", "widget":"slider", "min":150, "max":500, "step":10}'
    - '// @input float restOffsetDeg = 8 {"hint":"Resting spot angle from the center of view (deg, + = right) so she never covers the desk work", "widget":"slider", "min":-14, "max":14, "step":0.5}'
    - '// @input float recenterThresholdDeg = 12 {"hint":"Lazy follow: glide back to the front once she is this far (deg) from her spot in your view", "widget":"slider", "min":4, "max":30, "step":1}'
    - '// @input float recenterSeconds = 1.4 {"hint":"Longest glide back to the front (s) — used when you turned all the way around", "widget":"slider", "min":0.6, "max":3, "step":0.1}'
    - '// @input float wanderDeg = 3 {"hint":"Idle wandering inside the front zone: ± angle (deg)", "widget":"slider", "min":0, "max":6, "step":0.5}'
    - '// @input float wanderCm = 30 {"hint":"Idle wandering inside the front zone: ± distance (cm)", "widget":"slider", "min":0, "max":60, "step":5}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Behavior</span>"}'
    - '// @ui {"widget":"group_start", "label":"Behavior"}'
    - '// @input float walkSpeedCmPerSec = 100 {"hint":"Walking speed (cm/s) when she comes over or wanders", "widget":"slider", "min":30, "max":160, "step":5}'
    - '// @input float approachDistanceCm = 120 {"hint":"Where she stops in front of you when called (cm)", "widget":"slider", "min":80, "max":250, "step":5}'
    - '// @input float teaseDistanceCm = 150 {"hint":"Where she stops when she comes over to tease (cm)", "widget":"slider", "min":90, "max":300, "step":5}'
    - '// @input float attendSeconds = 15 {"hint":"Seconds she stays near you without interaction before stepping back to her spot", "widget":"slider", "min":3, "max":60, "step":1}'
    - '// @input bool debugLogs = true {"hint":"Print each state change to the Logger"}'
    - '// @ui {"widget":"group_end"}'
